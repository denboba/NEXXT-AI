PORT=3000
# Where the demo database (JSON) is stored
DB_PATH=data/db.json
# Protects /admin and /api/admin/*. Set it in any shared environment.
ADMIN_TOKEN=change-me
# Optional: lets the coach answer free-text questions with Claude (numbers still come from the engine)
ANTHROPIC_API_KEY=
# Model for anthropic (default claude-sonnet-5-5) or openai (default gpt-4.1-mini).
COACH_MODEL=
# Agent provider: offline, anthropic, openai (OpenAI-compatible), or bedrock.
# An explicit value always wins. Blank selects the first configured key in the order
# anthropic (ANTHROPIC_API_KEY) > openai (COMPAT_API_KEY) > bedrock (AWS_BEARER_TOKEN_BEDROCK) > offline.
LLM_PROVIDER=
COMPAT_API_KEY=
COMPAT_BASE_URL=https://api.openai.com/v1
AWS_REGION=eu-west-2
AWS_BEARER_TOKEN_BEDROCK=
# Exact model ID or inference-profile ID/ARN from Bedrock; do not use a display name.
BEDROCK_MODEL_ID=
# Total turn default 30 seconds, maximum 60 seconds; per-call default 20 seconds.
LLM_TIMEOUT_MS=30000
LLM_CALL_TIMEOUT_MS=20000
# Anthropic streaming: abort with a timeout if no stream event arrives within this many ms,
# or if the gap between two events exceeds it. The turn then finishes with the offline planner.
LLM_FIRST_TOKEN_MS=6000
LLM_TOKEN_BUDGET=24000
# npm run smoke:live exits 1 if any turn fell back to offline; set to 1 to allow fallbacks.
SMOKE_ALLOW_FALLBACK=
# Optional actual rates for your selected provider/model. Blank reports cost unknown.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
# Node 24+ built-in fetch proxy support; required for proxy-injected API keys here.
NODE_USE_ENV_PROXY=1
# Demo mode shows SMS codes on screen and enables the demo top-up. Set to 0 when a real SMS provider is wired in.
DEMO_MODE=1
